{
  "name": "jae-noi-pork-shop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:doctor && node --env-file=.dev.vars scripts/run-local-dev.mjs",
    "dev:remote-db": "LOCAL_D1_MODE=remote-staging npm run dev:remote-db:doctor && LOCAL_D1_MODE=remote-staging node --env-file=.dev.vars scripts/run-local-dev.mjs",
    "dev:setup": "node scripts/setup-local-env.mjs",
    "dev:doctor": "node scripts/doctor-local-dev.mjs",
    "dev:remote-db:doctor": "LOCAL_D1_MODE=remote-staging node --env-file=.dev.vars scripts/doctor-local-dev.mjs --skip-port",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "node scripts/check-cloudflare-build-env.mjs && DEPLOY_TARGET=cloudflare WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/configure-cloudflare-d1.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/assert-cloudflare-dist.mjs && wrangler deploy --config dist/server/wrangler.json",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern .vinext --ignore-pattern .agents",
    "db:generate": "drizzle-kit generate",
    "db:export-sheet-orders": "node --env-file=.dev.vars scripts/export-sheet-orders-to-d1-sql.mjs",
    "admin:cli": "node scripts/backend-cli.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.3",
    "next": "16.2.11",
    "promptpay-qr": "^0.5.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.61.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
